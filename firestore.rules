rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fields only the server may change (Cloudflare Pages Functions, service account).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Signup: the browser may create the document, but only as a free user
      // with no usage counters or activation timestamp.
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && !request.resource.data.keys().hasAny(['aiCallCount', 'aiCallMonth', 'planActivatedAt']);

      // Updates: allowed, as long as none of the protected fields change.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plan', 'aiCallCount', 'aiCallMonth', 'planActivatedAt']);

      // No deletes: deleting and recreating the document would reset the free counter.
      allow delete: if false;
    }

    match /logs/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}